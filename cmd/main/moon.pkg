import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "Ag108/MoonCache" @mooncache,
  "Ag108/MoonCache/adapters/async_http",
